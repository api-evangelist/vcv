              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "page size"
              },
              {
                "name": "filter[email]",
                "value": "",
                "type": "query",
                "description": "User email filter"
              },
              {
                "name": "filter[position]",
                "value": "",
                "type": "query",
                "description": "User position filter"
              },
              {
                "name": "with[]",
                "value": "",
                "type": "query",
                "description": "Relations to retrieve"
              }
            ]
          },
          "docs": "Get users list"
        },
        {
          "info": {
            "name": "GET /api/v3/users/{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://my.vcv.ai/api/v3/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
