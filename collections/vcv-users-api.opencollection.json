                "description": "entity id"
              },
              {
                "name": "with[]",
                "value": "",
                "type": "query",
                "description": "Relations to retrieve"
              }
            ]
          },
          "docs": "Get user detail"
        }
      ]
    }
  ],
  "bundled": true
