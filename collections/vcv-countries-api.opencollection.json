{
  "opencollection": "1.0.0",
  "info": {
    "name": "VCV chatbot countries API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "countries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /api/v3/countries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://my.vcv.ai/api/v3/countries",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "page number"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "page size"
              },
              {
                "name": "filter[code]",
                "value": "",
                "type": "query",
                "description": "Country code filter"
              }
            ]
          },
          "docs": "Get countries list"
        },
        {
          "info": {
            "name": "GET /api/v3/countries/{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://my.vcv.ai/api/v3/countries/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "entity id"
              }
            ]
          },
          "docs": "Get country detail"
        }
      ]
    }
  ],
  "bundled": true
}